# --- المرحلة الأولى: مرحلة المطبخ والطبخ (Build Stage) ---
# يا دوكر أحضر لي كمبيوتر افتراضي خفيف مثبت عليه لغة Node 20
# وسمّه مؤقتاً "build"
FROM node:20-alpine AS build

# أنشئ مجلداً داخل هذا الكمبيوتر الافتراضي باسم app
# واجعلنا نعمل بداخله
WORKDIR /app

#1. COPY (أمر النقل)
# هو أمر واضح وصريح للـ Docker: 
# "يا دوكر، خذ نسخة من ملف موجود في جهازي الآن، وانقله إلى داخل الحاوية الافتراضية".


# انسخ ملفات الوصفة (package.json)
# من جهازي الحقيقي إلى المطبخ الافتراضي
COPY package*.json ./


#1. RUN (أمر تشغيل داخل الحاوية)
# هو أمر يقول للـ Docker: 
#" terminal بما أنك فتحت الحاوية الجديدة، الآن شغّل لي هذا الأمر في الداخل".
# يأمر الحاوية بأن تقوم بتنفيذ أمر برمجي أو أمر نظام
# مثل (npm install) أو (apt-get update) أو (python script.py).


# قم بتحميل كل اكواد المكتبات المكتوبة في الوصفة
# (تجهيز المكونات في دولاب المطبخ)
RUN npm install

# الآن انسخ بقية أكواد المشروع (الصفحات والـ Components) إلى داخل المطبخ
COPY . .

# اضغط واكبس كود الريأكت المعقد وحوّله إلى مجلد ملفات عادية ونظيفة اسمه 
# (dist)
RUN npm run build


# --- المرحلة الثانية: مرحلة صالة العرض النظيفة (Production Stage) ---
# اغلق الكمبيوتر الأول تماماً، وافتح كمبيوتر جديد ونظيف جداً عليه خادم الـ 
#Nginx:
#وظيفته الوحيدة والأساسية في الحياة هي استقبال زوار الموقع، 
#وأخذ ملفات الـ HTML والـ CSS والـ JS
# النظيفة والمضغوطة، وتقديمها لهم بأقصى سرعة وأمان ممكنين
FROM nginx:alpine

# (السرقة الحلال): اذهب للمطبخ (build)
#،  (dist) واسرق منه فقط مجلد الكيك الجاهز 
#(/usr/share/nginx/html) Nignx وضعه في ملف عرض الـ 
COPY --from=build /app/dist /usr/share/nginx/html

# خذ ملف إعدادات الـ Nginx
# من جهازي وضعه في الحاوية لكي يفهم الخادم كيف يوجه الروابط بدون أخطاء
COPY nginx.conf /etc/nginx/conf.d/default.conf

# افتح النافذة رقم 80 (البورت الافتراضي للمواقع) لكي يستطيع زوار الإنترنت الدخول للموقع
EXPOSE 80




# الأمر النهائي: شجّع الـ Nginx واجعله يبدأ العمل فوراً في الواجهة ولا يتوقف أبداً
CMD ["nginx", "-g", "daemon off;"]

#1. CMD (الأمر النهائي عند التشغيل)
#كلمة CMD هي اختصار لـ Command (أمر).
#هناك فرق جوهري بينها وبين RUN:
# RUN: تنفذ الأوامر أثناء بناء وتجهيز الـ Image 
#(مثل تحميل المكتبات وبناء الكود).

#CMD:  تماماً، لا تعمل أثناء البناء أبداً، بل تنتظر حتى تنتهي الـ Image 
#  وتعمل فقط لحظة تشغيل الحاوية (Container Run).
# هي تقول للدوكر: "هذا هو الأمر الرئيسي الذي يجب أن يظل يعمل طوال حياة هذه الحاوية".

